# macOS
.DS_Store

# Flutter / Dart tool cache — generated by flutter pub get and flutter run
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Build output
/build/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
.vscode/
# Local secrets — Gemini key etc. consumed via --dart-define-from-file.
# Use dart_defines.example.json as the template; never commit the real file.
dart_defines.json
captures/
.externalNativeBuild/
.cxx/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Android release artifacts
*.aab
*.apk
output-metadata.json

# Android local config
local.properties

# Keystore files
*.jks
*.keystore

# Google Services — added by `flutterfire configure`, keep out of source control
google-services.json

# Android Gradle
.gradle/

# Logs
*.log

# Android profiling
*.hprof
